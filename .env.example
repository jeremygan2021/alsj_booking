# 首次启动会自动生成独立的随机密钥，通常无需复制此文件。
GM_PASSWORD=replace-with-a-long-random-password
NPC_PASSWORD=replace-with-a-different-long-random-master-key
PORT=3000
HOST=127.0.0.1
COOKIE_SECURE=false
# DB_PATH=/absolute/persistent/path/alaska.sqlite

# 服务端大模型配置（OpenAI兼容接口）；三项齐全才会真实调用。
# 未配置时保存角色并生成明确标记的剧情模板，待GM审核。
# 填写以 /v1 结尾的兼容接口根地址；密钥仅保存在服务端环境。
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 默认结构化输出；兼容服务不支持json_schema时可改成json_object。
LLM_RESPONSE_FORMAT=json_schema
# AR 场景由运营发布；默认使用内置墙面试点，原扫码搜证保持可用。
# MiniMax一键生成头像、姓名、故事；密钥仅在服务端配置。
# 配置后，未单独指定LLM时也使用MiniMax生成NPC关联。
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_TEXT_MODEL=MiniMax-M2.5
MINIMAX_IMAGE_MODEL=image-01
# Optional: outfit vision defaults to the same MiniMax server key/base URL.
MINIMAX_VISION_API_KEY=
MINIMAX_VISION_BASE_URL=https://api.minimax.cn/v1
# MiniMax自动使用JSON提示与服务端校验，无需额外设置LLM_RESPONSE_FORMAT。
# AR_SCENES_FILE=/absolute/persistent/path/ar-scenes.json
# AR_ASSET_BASE_URL=https://assets.example.com/ar/
# 阿里云短信：凭据仅在服务端配置，不提交代码。
SMS_ENABLED=false
# 通用快捷验证码188888；开发与生产环境均可显式开启，默认关闭。
SMS_DEV_LOGIN_ENABLED=false
SMS_TEMPLATE_CODE=SMS_493295002
# SMS_SIGN_NAME=审核通过的短信签名
# ALIBABA_CLOUD_ACCESS_KEY_ID=
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# ALIBABA_CLOUD_SECURITY_TOKEN=
# SMS_CODE_SECRET=independent-long-random-secret
# 测试码仅限指定测试号码，并须设置到期时间（毫秒时间戳）；默认关闭。
# SMS_TEST_PHONE=
# SMS_TEST_CODE=
# SMS_TEST_EXPIRES_AT=0

# Private OSS assets (server only; unset/false retains local storage)
OSS_ENABLED=false
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# Character self-introduction speech (server only; falls back to MINIMAX_API_KEY)
# MINIMAX_SPEECH_API_KEY=
# MINIMAX_SPEECH_BASE_URL=https://api.minimax.cn/v1
# MINIMAX_SPEECH_MODEL=speech-2.8-hd

# Private dynamic role audio (falls back to the existing OSS credentials above)
# OSS_MEDIA_ENABLED=true
# OSS_MEDIA_ACCESS_KEY_ID=
# OSS_MEDIA_ACCESS_KEY_SECRET=
# MINIMAX_ASR_MODEL=asr-1.0

# Authorize at existing API, then redirect downloads to OSS (7-day signatures).
OSS_DIRECT_DOWNLOAD=false
