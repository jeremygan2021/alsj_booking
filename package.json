{
  "name": "alaska-nights",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node server/index.js",
    "dev:quick-login": "SMS_DEV_LOGIN_ENABLED=true node server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test tests/*.test.js",
    "test:postgres": "node scripts/test-postgres.js",
    "test:browser": "npm run build && playwright test",
    "export:materials": "python3 scripts/export-story-materials.py",
    "export:qr": "node scripts/generate-print-materials.js"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "@google/model-viewer": "^4.4.0",
    "express": "^5.1.0",
    "jsfeat": "0.0.8",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "three": "^0.183.2",
    "three-mindar": "npm:three@0.160.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.9",
    "vite": "^7.1.0"
  }
}
